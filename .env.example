# URL of the hosted backend (no trailing slash). Leave unset for local dev (Vite proxies /api).
VITE_API_URL=https://doctrack-api.onrender.com

# Server: set both to store data in Turso instead of a local SQLite file.
TURSO_DATABASE_URL=libsql://doctrack-yourname.turso.io
TURSO_AUTH_TOKEN=
# Server: password seeded for the admin account (defaults to admin123).
ADMIN_PASSWORD=
